# ==============================================================================
# Nexus MCP Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔧 Server Configuration
# ------------------------------------------------------------------------------

# Set to "true" to enable verbose logging on stderr.
# Helpful for debugging tool execution and profile switching.
DEBUG=false

# ------------------------------------------------------------------------------
# 🛡️ Security & Exploitation
# ------------------------------------------------------------------------------

# Set to "true" to enable high-risk exploit tools (pwntools_run, angr_analyze, etc.).
# WARNING: These tools execute user-provided code and are gated behind AST-validation.
NEXUS_ENABLE_EXPLOIT=false

# ------------------------------------------------------------------------------
# ⚡ Performance & Caching
# ------------------------------------------------------------------------------

# Number of seconds to cache identical tool results.
# Default: 3600 (1 hour). Set to 0 to disable caching.
CACHE_TTL_SECONDS=3600

# Maximum number of entries in the tool results cache.
# Default: 1000.
NEXUS_MAX_CACHE=1000

# Maximum number of parallel subprocesses allowed.
# Default: 4. Adjust based on your CPU/network capacity.
MAX_CONCURRENCY=4

# Timeout in milliseconds to wait for a slot in the execution queue.
# Default: 30000 (30 seconds).
NEXUS_QUEUE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 📂 Persistence & Reports
# ------------------------------------------------------------------------------

# Directory where tool outputs and reports will be saved.
# Default: /tmp/nexus-mcp.
NEXUS_OUTPUT_DIR=/tmp/nexus-mcp

# Maximum number of findings to keep in memory for pentest_notes.
# Default: 100.
NEXUS_MAX_NOTES=100

# Maximum age of findings in hours before they are automatically purged.
# Default: 24.
NEXUS_MAX_NOTE_AGE_HOURS=24

# ------------------------------------------------------------------------------
# 🔑 API Keys
# ------------------------------------------------------------------------------

# Shodan API Key (Required for shodan tools).
SHODAN_API_KEY=

# Spiderfoot API Key (Optional, enhances osint_scan).
SPIDERFOOT_API_KEY=

# WPScan API Token (Optional, used for vulnerability database lookups).
WPSCAN_API_TOKEN=