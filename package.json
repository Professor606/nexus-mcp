{
  "name": "nexus-mcp",
  "version": "1.0.0",
  "description": "High-performance stdio MCP server for penetration testing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nexus-mcp": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["mcp", "pentest", "security", "bugbounty", "recon" ,"redteam", "web-security", "osint", "network", "ctf", "cybersecurity"],
  "author": "Ahmad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/professor404/nexus-mcp.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts --profile full --debug",
    "test": "node --experimental-vm-modules node_modules/jest-cli/bin/jest.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js --profile full",
    "inspect:dev": "DANGEROUSLY_OMIT_AUTH=true && npx @modelcontextprotocol/inspector node dist/index.js --profile full",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:recon": "node dist/index.js --profile recon",
    "start:web": "node dist/index.js --profile web",
    "start:ctf": "node dist/index.js --profile ctf",
    "start:full": "node dist/index.js --profile full",
    "start:bugbounty": "node dist/index.js --profile bugbounty",
    "start:cloud": "node dist/index.js --profile cloud",
    "start:osint": "node dist/index.js --profile osint",
    "start:network": "node dist/index.js --profile network"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.0",
    "execa": "^9.0.0",
    "p-limit": "^6.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
